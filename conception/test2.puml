@startuml
skinparam linetype ortho
skinparam defaultFontSize 13
skinparam defaultFontColor #E0E0E0
skinparam roundcorner 12

skinparam actor {
  BackgroundColor #1E2A3A
  BorderColor #4A6FA5
  FontColor #90CAF9
  FontSize 12
}

skinparam usecase {
  BackgroundColor #1E2140
  BorderColor #3F51B5
  FontColor #C0CAF5
  FontSize 12
}

skinparam rectangle {
  BackgroundColor #12132A
  BorderColor #00E5FF
  FontColor #00E5FF
  BorderThickness 2
}

skinparam arrow {
  Color #64B5F6
  FontColor #B0BEC5
  FontSize 11
  Thickness 1.5
}

top to bottom direction

' ── Acteurs primaires (gauche) ──────────────────
actor "Opérateur\nde supervision" as op
actor "Administrateur"            as adm

' ── Acteurs externes (droite et bas) ────────────
actor "Ministère MEDD\n(Externe)"    as medd
actor "Système Gemini AI\n(Externe)" as gemini

rectangle "M'LAM — Tableau de bord de supervision urbaine" {

  ' Bloc Supervision
  usecase "Superviser le trafic"   as UC1
  usecase "Visualiser la carte"    as UC2
  usecase "Consulter les métriques" as UC3
  usecase "Filtrer les anomalies"  as UC7

  ' Bloc Rapport IA
  usecase "Sélectionner une anomalie" as UC4
  usecase "Générer rapport IA"        as UC5
  usecase "Transmettre au MEDD"       as UC6

  ' Bloc Administration
  usecase "Configurer la simulation"       as UC8
  usecase "Ajuster seuils d'alerte"        as UC9
  usecase "Anonymiser identifiants SHA-256" as UC10

}

' ── Associations acteurs → UC ───────────────────
op  --> UC1
op  --> UC4
op  --> UC7
adm --> UC8

medd   --> UC6
gemini --> UC5

' ── Relations UML correctes ─────────────────────

' <<include>> : flèche part du UC principal vers le UC inclus
UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>
UC4 ..> UC5 : <<include>>
UC5 ..> UC6 : <<include>>
UC8 ..> UC9  : <<include>>
UC8 ..> UC10 : <<include>>

' <<extend>> : flèche part du UC optionnel vers le UC de base
UC7 ..> UC1 : <<extend>>

@enduml